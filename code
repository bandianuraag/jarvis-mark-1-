<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>J.A.R.V.I.S. Interface</title>
    <style>
        :root {
            --neon-blue: #00d2ff;
            --dark-bg: #050b14;
            --hud-glow: rgba(0, 210, 255, 0.4);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Courier New', Courier, monospace;
        }

        body {
            background-color: var(--dark-bg);
            color: var(--neon-blue);
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            overflow: hidden;
            padding: 20px;
            background-image: 
                radial-gradient(circle, rgba(0,210,255,0.05) 0%, rgba(5,11,20,0.9) 100%);
        }

        /* HUD Frame Elements */
        .hud-header {
            text-align: center;
            letter-spacing: 3px;
            text-transform: uppercase;
            border-bottom: 2px solid var(--neon-blue);
            width: 100%;
            padding-bottom: 10px;
            box-shadow: 0 5px 15px var(--hud-glow);
            font-size: 1.2rem;
        }

        /* Central Arc Reactor / Visualizer */
        .reactor-container {
            position: relative;
            width: 200px;
            height: 200px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: auto;
        }

        .ring {
            position: absolute;
            border: 2px dashed var(--neon-blue);
            border-radius: 50%;
            animation: spin 10s linear infinite;
        }

        .ring:nth-child(1) { width: 100%; height: 100%; border-color: rgba(0,210,255,0.3); }
        .ring:nth-child(2) { width: 75%; height: 75%; animation-direction: reverse; animation-duration: 6s; }
        .ring:nth-child(3) { width: 50%; height: 50%; border-style: solid; animation-duration: 4s; }

        .core {
            width: 40px;
            height: 40px;
            background-color: var(--neon-blue);
            border-radius: 50%;
            box-shadow: 0 0 25px var(--neon-blue), 0 0 50px var(--neon-blue);
            transition: transform 0.2s ease;
        }

        .listening .core {
            transform: scale(1.3);
            animation: pulse 1s infinite alternate;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @keyframes pulse {
            0% { box-shadow: 0 0 10px var(--neon-blue); }
            100% { box-shadow: 0 0 40px #fff, 0 0 80px var(--neon-blue); }
        }

        /* Chat Log Display */
        .terminal-window {
            width: 100%;
            max-width: 600px;
            height: 150px;
            background: rgba(0, 210, 255, 0.03);
            border: 1px solid var(--neon-blue);
            box-shadow: inset 0 0 15px rgba(0,210,255,0.1);
            padding: 10px;
            overflow-y: auto;
            font-size: 0.9rem;
            margin-bottom: 20px;
        }

        .log-entry {
            margin-bottom: 6px;
        }

        .log-user { color: #ffffff; }
        .log-jarvis { color: var(--neon-blue); }

        /* Control Button */
        .controls {
            display: flex;
            gap: 15px;
            margin-bottom: 10px;
        }

        button {
            background: transparent;
            color: var(--neon-blue);
            border: 1px solid var(--neon-blue);
            padding: 10px 25px;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            box-shadow: 0 0 10px var(--hud-glow);
            transition: all 0.3s ease;
        }

        button:hover {
            background: var(--neon-blue);
            color: var(--dark-bg);
            box-shadow: 0 0 20px var(--neon-blue);
        }
    </style>
</head>
<body>

    <div class="hud-header">
        J.A.R.V.I.S. // System Online
    </div>

    <div class="reactor-container" id="reactor">
        <div class="ring"></div>
        <div class="ring"></div>
        <div class="ring"></div>
        <div class="core"></div>
    </div>

    <div class="terminal-window" id="terminal">
        <div class="log-entry log-jarvis">> Initializing protocols... Systems fully operational, Sir.</div>
    </div>

    <div class="controls">
        <button id="talkBtn">Speak to JARVIS</button>
    </div>

    <script>
        const talkBtn = document.getElementById('talkBtn');
        const reactor = document.getElementById('reactor');
        const terminal = document.getElementById('terminal');

        // Check for Web Speech API support
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        const synth = window.speechSynthesis;

        if (!SpeechRecognition) {
            appendLog("JARVIS: Speech recognition is not supported in this browser. Please use Google Chrome.", "jarvis");
            talkBtn.disabled = true;
        }

        const recognition = new SpeechRecognition();
        recognition.continuous = false;
        recognition.interimResults = false;
        recognition.lang = 'en-US';

        talkBtn.addEventListener('click', () => {
            try {
                recognition.start();
            } catch (e) {
                console.log("Recognition already active.");
            }
        });

        recognition.onstart = () => {
            reactor.classList.add('listening');
            appendLog("JARVIS: Listening...", "jarvis");
        };

        recognition.onresult = (event) => {
            const userSpeech = event.results[0][0].transcript;
            appendLog(`You: ${userSpeech}`, "user");
            processCommand(userSpeech);
        };

        recognition.onerror = (event) => {
            appendLog(`JARVIS: Error encountered -> ${event.error}`, "jarvis");
            reactor.classList.remove('listening');
        };

        recognition.onend = () => {
            reactor.classList.remove('listening');
        };

        // Intelligent rule-based response engine (Can be hooked up to an LLM API later)
        function processCommand(command) {
            let reply = "I am afraid I don't have the data for that query, Sir.";
            const cmd = command.toLowerCase();

            if (cmd.includes('hello') || cmd.includes('hi jarvis')) {
                reply = "Good day, Sir. All systems are operating at peak efficiency.";
            } else if (cmd.includes('how are you')) {
                reply = "Operating normally, Sir. Ready when you are.";
            } else if (cmd.includes('time')) {
                const now = new Date();
                reply = `The current time is ${now.toLocaleTimeString()}.`;
            } else if (cmd.includes('date')) {
                const now = new Date();
                reply = `Today's date is ${now.toDateString()}.`;
            } else if (cmd.includes('who are you') || cmd.includes('what are you')) {
                reply = "I am Just A Rather Very Intelligent System, your personal assistant.";
            } else if (cmd.includes('calculate') || cmd.includes('plus') || cmd.includes('minus') || cmd.includes('multiplied') || cmd.includes('divided')) {
                try {
                    // Simple arithmetic solver
                    let mathQuery = cmd.replace('calculate', '').replace('what is', '').trim();
                    mathQuery = mathQuery.replace(/plus/g, '+').replace(/minus/g, '-').replace(/multiplied by/g, '*').replace(/divided by/g, '/');
                    let result = eval(mathQuery);
                    reply = `The result is ${result}, Sir.`;
                } catch {
                    reply = "I was unable to compute that calculation, Sir.";
                }
            } else {
                // Fallback search or generic conversational fallback
                reply = `You asked about "${command}". While my full cloud neural network isn't linked locally, I am fully functional.`;
            }

            appendLog(`JARVIS: ${reply}`, "jarvis");
            speak(reply);
        }

        // Text-to-Speech function
        function speak(text) {
            if (synth.speaking) {
                synth.cancel();
            }
            const utterThis = new SpeechSynthesisUtterance(text);
            
            // Try to find a crisp robotic/British voice if available
            const voices = synth.getVoices();
            const preferredVoice = voices.find(v => v.name.includes('UK English') || v.name.includes('Google UK English Male') || v.name.includes('Oliver'));
            if (preferredVoice) {
                utterThis.voice = preferredVoice;
            }
            
            utterThis.pitch = 0.9; // Slightly lower, authoritative pitch
            utterThis.rate = 1.0;
            synth.speak(utterThis);
        }

        function appendLog(text, sender) {
            const entry = document.createElement('div');
            entry.classList.add('log-entry');
            entry.classList.add(sender === 'user' ? 'log-user' : 'log-jarvis');
            entry.textContent = `> ${text}`;
            terminal.appendChild(entry);
            terminal.scrollTop = terminal.scrollHeight;
        }
    </script>
</body>
</html>
